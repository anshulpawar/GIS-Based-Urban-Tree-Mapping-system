# ==============================================================================
# Urban GreenWatch Backend Environment Variables
# For Render deployment, configure these in the Render Dashboard Environment settings.
# For Local development, copy this file to .env and fill in your values.
# ==============================================================================

# Supabase Database & PostGIS Credentials
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-publishable-key
SUPABASE_SECRET_KEY=your-supabase-secret-key

# Google Earth Engine (GEE) Authentication
# For Render / Cloud Production: Paste the entire JSON service account key string below:
# GEE_SERVICE_ACCOUNT_JSON='{"type": "service_account", "project_id": "...", "private_key": "...", "client_email": "..."}'
GEE_SERVICE_ACCOUNT_JSON=

# For Local Development: Use a service account email and private key file path:
GEE_SERVICE_ACCOUNT=your-gee-service-account@project.iam.gserviceaccount.com
GEE_PRIVATE_KEY_FILE=gee-private-key.json
GEE_PROJECT_ID=urban-tree-mapping

# CORS Allowed Origins
# Comma-separated list of allowed origins (e.g., https://your-app.vercel.app,http://localhost:3000) or * for permissive access
ALLOWED_ORIGINS=*

# Google Gemini AI Configuration (Primary Insights Engine)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.8-flash
# Optional secondary fallback model if primary returns transient 503/429:
# GEMINI_FALLBACK_MODEL=gemini-2.5-flash

# Groq AI Configuration (Secondary Cloud LLM Fallback)
# GROQ_API_KEY=your-groq-api-key-here
# GROQ_MODEL=openai/gpt-oss-120b

# API Server Configuration
API_V1_STR=/api
PROJECT_NAME="GIS Urban Tree Mapping API"
DEBUG=False
PORT=8000
HOST=0.0.0.0
