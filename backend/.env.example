# Supabase Database & PostGIS Credentials
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-publishable-key
SUPABASE_SECRET_KEY=your-supabase-secret-key

# Google Earth Engine (GEE) Service Account Credentials
GEE_SERVICE_ACCOUNT=your-gee-service-account@project.iam.gserviceaccount.com
GEE_PRIVATE_KEY_FILE=gee-private-key.json

# Google Gemini AI Configuration
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# API Server Configuration
API_V1_STR=/api
PROJECT_NAME="GIS Urban Tree Mapping API"
DEBUG=True
PORT=8000
HOST=0.0.0.0